# Keep owned text portable; preserve vendor and firmware payloads byte-for-byte.
/.gitignore text eol=lf
/.gitattributes text eol=lf
/.github/** text eol=lf
/README.md text eol=lf
/docs/** text eol=lf
/apps/a35/Makefile text eol=lf
/apps/a35/.gitattributes text eol=lf
/apps/a35/**/*.md text eol=lf
/apps/a35/**/*.py text eol=lf
/apps/a35/**/*.sh text eol=lf
/firmware/** -text
/firmware/**/*.md text eol=lf
/firmware/**/.gitignore text eol=lf
/apps/a35/stai_mpu/** -text
/apps/a35/hud/cJSON.c -text
/apps/a35/hud/cJSON.h -text whitespace=-blank-at-eol
/apps/a35/hud/LICENSE.cJSON -text whitespace=-blank-at-eof
