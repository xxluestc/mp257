[Unit]
Description=DVR System
# Dashboard/UDP 可以在网络地址配置前监听，因此无需等待 network.target。
# 业务脚本只等待本项目实际使用的设备，不再阻塞于全局 udev settle。
# 关闭默认 basic.target 依赖，让关键风险链在 local-fs 与 M33 就绪后先启动；
# Dashboard 仍按普通服务顺序启动，且不反向阻塞 DVR。
DefaultDependencies=no
Wants=dvr-m33.service radar-dashboard.service
After=local-fs.target dvr-m33.service systemd-journald.socket
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
Environment=STOP_M33_ON_EXIT=0
Environment=ALLOW_M33_RESET_ON_START_FAILURE=0
ExecStart=/xxl/camera_detect/start_dvr.sh
Restart=on-failure
RestartSec=5
WorkingDirectory=/xxl/camera_detect
# 正常退出时给当前编码一次短时善后机会；真正的可靠性来自运行期异步编码、
# 完整解码校验和fsync，而不是用超长停止超时掩盖问题。物理断电不受此参数保护。
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
