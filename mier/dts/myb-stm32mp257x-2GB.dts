		simple-audio-card,widgets = "Headphone\0Headphone Jack\0Microphone\0Mic Jack";
		simple-audio-card,routing = "Headphone Jack\0LOUT1\0Headphone Jack\0ROUT1\0LINPUT1\0Mic Jack\0RINPUT1\0Mic Jack";

		simple-audio-card,cpu {
			system-clock-frequency = <0xac4400>;
			sound-dai = <0x31>;
			phandle = <0xbe>;
		};

		simple-audio-card,codec {
			sound-dai = <0xbf>;
			system-clock-frequency = <0xac4400>;
			phandle = <0x19a>;
		};
	};

