		rtc@46000000 {
			compatible = "st,stm32mp25-rtc";
			reg = <0x46000000 0x400>;
			clocks = <0x07 0x4b 0x07 0x4c>;
			clock-names = "pclk\0rtc_ck";
			interrupts-extended = <0x54 0x11 0x04>;
			status = "disabled";
			phandle = <0x17d>;
		};

		tamp@46010000 {
			compatible = "st,stm32mp25-tamp\0syscon\0simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x46010000 0x400>;
			ranges;
			phandle = <0x17e>;

			nvram@46010100 {
				compatible = "st,stm32mp25-tamp-nvram";
				reg = <0x46010100 0x200>;
				phandle = <0x17f>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					tamp-bkp@180 {
						reg = <0x180 0x04>;
						phandle = <0x96>;
					};

					tamp-bkp@184 {
						reg = <0x184 0x04>;
						phandle = <0xaa>;
					};

					tamp-bkp@188 {
						reg = <0x188 0x04>;
						phandle = <0xab>;
					};
				};
			};

			reboot-mode {
				compatible = "nvmem-reboot-mode";
				nvmem-cells = <0x96>;
				nvmem-cell-names = "reboot-mode";
				mode-normal = <0x00>;
				mode-fastboot = <0x01>;
				mode-recovery = <0x02>;
				mode-stm32cubeprogrammer = <0x03>;
				mode-ums_mmc0 = <0x10>;
				mode-ums_mmc1 = <0x11>;
				mode-ums_mmc2 = <0x12>;
				mode-romcode_serial = <0xff>;
				phandle = <0x180>;
			};
		};

		pinctrl@46200000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "st,stm32mp257-z-pinctrl";
			ranges = <0x00 0x46200000 0x400>;
			interrupt-parent = <0x1e>;
			phandle = <0x97>;

			gpio@46200000 {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x00 0x400>;
				clocks = <0x07 0x64>;
				st,bank-name = "GPIOZ";
				st,bank-ioport = <0x0b>;
				status = "okay";
				ngpios = <0x0a>;
				gpio-ranges = <0x97 0x00 0x190 0x0a>;
				phandle = <0x33>;
			};

			i2c8-0 {
				phandle = <0x58>;

				pins {
					pinmux = <0x19409 0x19909>;
					bias-disable;
					drive-open-drain;
					slew-rate = <0x00>;
				};
			};

