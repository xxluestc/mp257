/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "MYiR STM32MP257x Evaluation Board 2";
	compatible = "myir,myb-stm32mp257x\0st,stm32mp257f-ev1\0st,stm32mp257";

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a35";
			device_type = "cpu";
			reg = <0x00>;
			enable-method = "psci";
			clocks = <0x01 0x00>;
			clock-names = "cpu";
			power-domains = <0x02>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			phandle = <0x04>;
		};

		idle-states {
			entry-method = "psci";

			cpu-power-down {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01>;
				local-timer-stop;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x1f4>;
				min-residency-us = <0x3e8>;
				phandle = <0x0b>;
			};
		};

		domain-idle-states {

			domain-stop1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x11>;
				entry-latency-us = <0x190>;
				exit-latency-us = <0x4b0>;
				min-residency-us = <0x5dc>;
				phandle = <0x0d>;
			};

			domain-lp-stop1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x21>;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x7d0>;
				min-residency-us = <0xbb8>;
				phandle = <0x0e>;
			};

			domain-lplv-stop1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x211>;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0xbb8>;
				min-residency-us = <0xfa0>;
				phandle = <0x10>;
			};
		};

		cpu@1 {
			compatible = "arm,cortex-a35";
			device_type = "cpu";
			reg = <0x01>;
			enable-method = "psci";
			clocks = <0x01 0x00>;
			clock-names = "cpu";
			power-domains = <0x03>;
			power-domain-names = "psci";
			phandle = <0x05>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a35-pmu";
		interrupts = <0x00 0x170 0x04 0x00 0x171 0x04>;
		interrupt-affinity = <0x04 0x05>;
		interrupt-parent = <0x06>;
	};

	watchdog {
		compatible = "arm,smc-wdt";
		arm,smc-id = <0xbc000000>;
		status = "okay";
		timeout-sec = <0x20>;
		phandle = <0xc0>;
	};

	clocks {

		clk-rcbsec {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x3d09000>;
			phandle = <0x51>;
		};

		clk-ext-camera {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x16e3600>;
			phandle = <0x5a>;
		};

		pad-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x5f5e100>;
			phandle = <0xc1>;
		};

		clk-ext-sound {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0xac4400>;
			phandle = <0xc2>;
		};

		clk-ext-phy1 {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x17d7840>;
			phandle = <0x79>;
		};

		clk-ext-phy2 {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x17d7840>;
			phandle = <0x8b>;
		};

		clk-ext-phy3 {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x17d7840>;
			phandle = <0xc3>;
		};
	};

	max98357a_codec: max98357a {
		compatible = "maxim,max98357a";
		#sound-dai-cells = <0x00>;
		status = "okay";
		phandle = <0x501>;
	};

	sound {
		compatible = "simple-audio-card";
		label = "MAX98357A";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x100>;

		simple-audio-card,cpu {
			sound-dai = <0x10b>;
			bitclock-master;
			frame-master;
			dai-tdm-slot-num = <0x02>;
			dai-tdm-slot-width = <0x20>;
		};

		simple-audio-card,codec {
			sound-dai = <0x501>;
		};
	};

	replicator {
		compatible = "arm,coresight-static-replicator";
		clocks = <0x07 0x78>;
		clock-names = "apb_pclk";
		status = "okay";
		phandle = <0xc4>;

		in-ports {

			port {

				endpoint {
					remote-endpoint = <0x08>;
					phandle = <0x9d>;
				};
			};
		};

		out-ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				endpoint {
					remote-endpoint = <0x09>;
					phandle = <0x9e>;
				};
			};

			port@1 {
				reg = <0x01>;

				endpoint {
					remote-endpoint = <0x0a>;
					phandle = <0x9f>;
				};
			};
		};
	};

	firmware {

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			interrupt-parent = <0x06>;
			interrupts = <0x01 0x0f 0x308>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			phandle = <0xc5>;
		};

		scmi {
			compatible = "linaro,scmi-optee";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			linaro,optee-channel-id = <0x00>;
			phandle = <0xc6>;

			protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <0x01>;
				phandle = <0x90>;
			};

			protocol@13 {
				reg = <0x13>;
				#clock-cells = <0x01>;
				phandle = <0x01>;
			};

			protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x07>;
			};

			protocol@16 {
				reg = <0x16>;
				#reset-cells = <0x01>;
				phandle = <0x1d>;
			};

			protocol@17 {
				reg = <0x17>;
				phandle = <0xc7>;

				regulators {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0xc8>;

					regulator@0 {
						reg = <0x00>;
						regulator-name = "vddio1";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x69>;
					};

					regulator@1 {
						reg = <0x01>;
						regulator-name = "vddio2";
						phandle = <0x70>;
					};

					regulator@2 {
						reg = <0x02>;
						regulator-name = "vddio3";
						phandle = <0xc9>;
					};

					regulator@3 {
						reg = <0x03>;
						regulator-name = "vddio4";
						phandle = <0xca>;
					};

					regulator@5 {
						reg = <0x05>;
						regulator-name = "vdd33ucpd";
						phandle = <0xcb>;
					};

					regulator@7 {
						reg = <0x07>;
						regulator-name = "vdda18adc";
						phandle = <0xcc>;
					};

					regulator@11 {
						reg = <0x0b>;
						regulator-name = "vddcore";
						phandle = <0x61>;
					};

					regulator@14 {
						reg = <0x0e>;
						regulator-name = "v1v8";
						phandle = <0x4d>;
					};

					regulator@16 {
						reg = <0x10>;
						regulator-name = "v3v3";
						phandle = <0x74>;
					};

					regulator@18 {
						reg = <0x12>;
						regulator-name = "vdd_emmc";
						phandle = <0x6f>;
					};

					regulator@20 {
						reg = <0x14>;
						regulator-name = "vdd3v3_usb";
						phandle = <0x17>;
					};

					regulator@23 {
						reg = <0x17>;
						regulator-name = "vdd_sdcard";
						phandle = <0x68>;
					};
				};
			};
		};
	};

	interrupt-controller@4ac00000 {
		compatible = "arm,cortex-a7-gic";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		interrupt-parent = <0x06>;
		reg = <0x00 0x4ac10000 0x00 0x1000 0x00 0x4ac20000 0x00 0x2000 0x00 0x4ac40000 0x00 0x2000 0x00 0x4ac60000 0x00 0x2000>;
		interrupts = <0x01 0x09 0x308>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x06>;

		v2m@48090000 {
			compatible = "arm,gic-v2m-frame";
			reg = <0x00 0x48090000 0x00 0x1000>;
			msi-controller;
			phandle = <0x84>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x0b>;
			power-domains = <0x0c>;
			phandle = <0x02>;
		};

		power-domain-cluster {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x0d 0x0e>;
			power-domains = <0x0f>;
			phandle = <0x0c>;
		};

		power-domain-retention {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x10>;
			phandle = <0x0f>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x0b>;
			power-domains = <0x0c>;
			phandle = <0x03>;
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x11 0x01>;

			trips {

				cpu-alert {
					temperature = <0x1adb0>;
					hysteresis = <0x2710>;
					type = "passive";
					phandle = <0x12>;
				};

				cpu-crit {
					temperature = <0x1dc90>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				gpu-alert {
					temperature = <0x1adb0>;
					hysteresis = <0x2710>;
					type = "passive";
					phandle = <0x13>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x12>;
					cooling-device = <0x04 0x01 0x01>;
				};

				map1 {
					trip = <0x13>;
					cooling-device = <0x14 0x01 0x06>;
				};
			};
		};

		soc-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x11 0x00>;

			trips {

				soc-crit {
					temperature = <0x1dc90>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x06>;
		interrupts = <0x01 0x0d 0x308 0x01 0x0e 0x308 0x01 0x0b 0x308 0x01 0x0a 0x308>;
		arm,no-tick-in-suspend;
	};

	usb2-phy1 {
		compatible = "st,stm32mp25-usb2phy";
		#phy-cells = <0x00>;
		#clock-cells = <0x00>;
		st,syscfg = <0x15 0x2400>;
		clocks = <0x16 0x140>;
		resets = <0x16 0x3f>;
		status = "okay";
		vdd33-supply = <0x17>;
		phandle = <0x7f>;
	};

	usb2-phy2 {
		compatible = "st,stm32mp25-usb2phy";
		#phy-cells = <0x00>;
		#clock-cells = <0x00>;
		st,syscfg = <0x15 0x2800>;
		clocks = <0x16 0x128>;
		resets = <0x16 0x40>;
		status = "okay";
		vdd33-supply = <0x17>;
		phandle = <0x81>;
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		interrupt-parent = <0x06>;
		ranges = <0x00 0x00 0x00 0x80000000>;

		dma-controller@40400000 {
			compatible = "st,stm32-dma3";
			reg = <0x40400000 0x1000>;
			interrupts = <0x00 0x21 0x04 0x00 0x22 0x04 0x00 0x23 0x04 0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x26 0x04 0x00 0x27 0x04 0x00 0x28 0x04 0x00 0x29 0x04 0x00 0x2a 0x04 0x00 0x2b 0x04 0x00 0x2c 0x04 0x00 0x2d 0x04 0x00 0x2e 0x04 0x00 0x2f 0x04 0x00 0x30 0x04>;
			clocks = <0x07 0x65>;
			power-domains = <0x0f>;
			#dma-cells = <0x03>;
			st,axi-max-burst-len = <0x10>;
			memory-region = <0x18>;
			phandle = <0x1c>;
		};

		dma-controller@40410000 {
			compatible = "st,stm32-dma3";
			reg = <0x40410000 0x1000>;
			interrupts = <0x00 0x31 0x04 0x00 0x32 0x04 0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04 0x00 0x39 0x04 0x00 0x3a 0x04 0x00 0x3b 0x04 0x00 0x3c 0x04 0x00 0x3d 0x04 0x00 0x3e 0x04 0x00 0x3f 0x04 0x00 0x40 0x04>;
			clocks = <0x07 0x66>;
			power-domains = <0x0f>;
			#dma-cells = <0x03>;
			st,axi-max-burst-len = <0x10>;
			memory-region = <0x19>;
			phandle = <0xcd>;
		};

		dma-controller@40420000 {
			compatible = "st,stm32-dma3";
			reg = <0x40420000 0x1000>;
			interrupts = <0x00 0x41 0x04 0x00 0x42 0x04 0x00 0x43 0x04 0x00 0x44 0x04 0x00 0x45 0x04 0x00 0x46 0x04 0x00 0x47 0x04 0x00 0x48 0x04 0x00 0x49 0x04 0x00 0x4a 0x04 0x00 0x4b 0x04 0x00 0x4c 0x04 0x00 0x4d 0x04 0x00 0x4e 0x04 0x00 0x4f 0x04 0x00 0x50 0x04>;
			clocks = <0x07 0x67>;
			power-domains = <0x0f>;
			#dma-cells = <0x03>;
			st,axi-max-burst-len = <0x10>;
			memory-region = <0x1a>;
			phandle = <0xce>;
		};

		mailbox@40490000 {
			compatible = "st,stm32mp1-ipcc";
			#mbox-cells = <0x01>;
			reg = <0x40490000 0x400>;
			st,proc-id = <0x00>;
			interrupts = <0x00 0xab 0x04 0x00 0xac 0x04>;
			interrupt-names = "rx\0tx";
			clocks = <0x07 0x69>;
			status = "okay";
			phandle = <0xac>;
		};

		ommanager@40500000 {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			compatible = "st,stm32mp25-omm";
			reg = <0x40500000 0x400 0x60000000 0x10000000>;
			reg-names = "omm\0omm_mm";
			clocks = <0x16 0x6b>;
			resets = <0x16 0x5a>;
			st,syscfg-amcr = <0x15 0x2c00 0x07>;
			access-controllers = <0x1b 0x6f>;
			power-domains = <0x0c>;
			status = "disabled";
			ranges = <0x00 0x00 0x40430000 0x400 0x01 0x00 0x40440000 0x400>;
			phandle = <0xcf>;

			spi@40430000 {
				compatible = "st,stm32mp25-omi";
				reg = <0x00 0x00 0x400>;
				interrupts = <0x00 0xa3 0x04>;
				dmas = <0x1c 0x02 0x62 0x3121 0x1c 0x02 0x42 0x3112>;
				dma-names = "tx\0rx";
				st,syscfg-dlyb = <0x15 0x1000>;
				clocks = <0x07 0x74>;
				resets = <0x1d 0x05 0x1d 0x06>;
				access-controllers = <0x1b 0x4a>;
				power-domains = <0x0c>;
				status = "disabled";
				phandle = <0xd0>;
			};

			spi@40440000 {
				compatible = "st,stm32mp25-omi";
				reg = <0x01 0x00 0x400>;
				interrupts = <0x00 0xa4 0x04>;
				dmas = <0x1c 0x03 0x62 0x3121 0x1c 0x03 0x42 0x3112>;
				dma-names = "tx\0rx";
				st,syscfg-dlyb = <0x15 0x1400>;
				clocks = <0x07 0x75>;
				resets = <0x1d 0x07 0x1d 0x08>;
				access-controllers = <0x1b 0x4b>;
				power-domains = <0x0c>;
				status = "disabled";
				phandle = <0xd1>;
			};
		};

		bus@42080000 {
			compatible = "st,stm32mp25-rifsc\0simple-bus";
			reg = <0x42080000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			#access-controller-cells = <0x01>;
			ranges;
			st,mem-map = <0x200c0000 0x2000 0x200c2000 0x2000 0x200c4000 0x4000>;
			phandle = <0x1b>;

			timer@40000000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40000000 0x400>;
				interrupts = <0x00 0x69 0x04>;
				interrupt-names = "global";
				clocks = <0x16 0xdb>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x1b 0x01>;
				power-domains = <0x0c>;
				status = "disabled";
				phandle = <0xd2>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					#pwm-cells = <0x03>;
					status = "disabled";
				};

				timer@1 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x01>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40010000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40010000 0x400>;
				interrupts = <0x00 0x6a 0x04>;
				interrupt-names = "global";
				clocks = <0x16 0xdc>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x1b 0x02>;
				power-domains = <0x0c>;
				status = "disabled";
				phandle = <0xd3>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					#pwm-cells = <0x03>;
					status = "disabled";
				};

				timer@2 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x02>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40020000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40020000 0x400>;
				interrupts = <0x00 0x6b 0x04>;
				interrupt-names = "global";
				clocks = <0x16 0xdd>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x1b 0x03>;
				power-domains = <0x0c>;
				status = "disabled";
				phandle = <0xd4>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					#pwm-cells = <0x03>;
					status = "disabled";
				};

				timer@3 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x03>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40030000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40030000 0x400>;
				interrupts = <0x00 0x7c 0x04>;
				interrupt-names = "global";
				clocks = <0x16 0xde>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x1b 0x04>;
				power-domains = <0x0c>;
				status = "disabled";
				phandle = <0xd5>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					#pwm-cells = <0x03>;
					status = "disabled";
				};

				timer@4 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x04>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40040000 {
				compatible = "st,stm32mp25-timers";
