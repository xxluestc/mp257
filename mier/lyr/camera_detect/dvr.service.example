[Unit]
Description=DVR System
# Dashboard/UDP 可以在网络地址配置前监听，因此无需等待 network.target。
# 业务脚本只等待本项目实际使用的设备，不再阻塞于全局 udev settle。
Wants=dvr-m33.service radar-dashboard.service
After=local-fs.target dvr-m33.service radar-dashboard.service

[Service]
Type=simple
Environment=STOP_M33_ON_EXIT=0
Environment=ALLOW_M33_RESET_ON_START_FAILURE=0
ExecStart=/xxl/camera_detect/start_dvr.sh
Restart=on-failure
RestartSec=5
WorkingDirectory=/xxl/camera_detect
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
