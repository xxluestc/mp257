#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <termios.h>
#include <sys/select.h>
#include "sms.h"

static int g_fd = -1;   // 串口文件描述符

/**
 * 配置串口属性：115200 8N1，原始模式
 */
static int set_serial_attr(int fd) {
    struct termios tty;
    if (tcgetattr(fd, &tty) != 0) return -1;

    cfsetospeed(&tty, B115200);
    cfsetispeed(&tty, B115200);

    tty.c_cflag |= (CLOCAL | CREAD);
    tty.c_cflag &= ~CSIZE;
    tty.c_cflag |= CS8;
    tty.c_cflag &= ~PARENB;
    tty.c_cflag &= ~CSTOPB;
    tty.c_cflag &= ~CRTSCTS;

    tty.c_lflag &= ~(ICANON | ECHO | ECHOE | ISIG);
    tty.c_iflag &= ~(IXON | IXOFF | IXANY);
    tty.c_iflag &= ~(INLCR | ICRNL | IGNCR);
    tty.c_oflag &= ~OPOST;

    tty.c_cc[VMIN] = 0;
    tty.c_cc[VTIME] = 10;

    return tcsetattr(fd, TCSANOW, &tty);
}

/**
 * 发送 AT 命令并等待期望的响应
 * @return 0=成功  -1=超时  -2=响应不匹配
 */
static int send_at_cmd(const char *cmd, const char *expected, int timeout_ms) {
    if (g_fd < 0) return -1;

    // 先清空缓冲区
    tcflush(g_fd, TCIFLUSH);

    printf("[SMS] Send: %s", cmd);
    write(g_fd, cmd, strlen(cmd));
    tcdrain(g_fd);

    fd_set set;
    struct timeval tv;
    char buf[128];

    FD_ZERO(&set);
    FD_SET(g_fd, &set);
    tv.tv_sec = timeout_ms / 1000;
    tv.tv_usec = (timeout_ms % 1000) * 1000;

    int ret = select(g_fd + 1, &set, NULL, NULL, &tv);
    if (ret <= 0) {
        printf("[SMS] select timeout or error\n");
        return -1;
    }

    ssize_t n = read(g_fd, buf, sizeof(buf) - 1);
    if (n > 0) {
        buf[n] = '\0';
        printf("[SMS] Response: %s", buf);
        if (strstr(buf, expected) != NULL) return 0;
    }
    return -2;
}

/**
 * 初始化短信模块
 */
int sms_init(const char *device, int baudrate) {
    printf("[SMS] Opening %s...\n", device);

    g_fd = open(device, O_RDWR | O_NOCTTY | O_SYNC);
    if (g_fd < 0) {
        perror("[SMS] open failed");
        return -1;
    }
    printf("[SMS] fd=%d\n", g_fd);

    if (set_serial_attr(g_fd) != 0) {
        printf("[SMS] set_serial_attr failed\n");
        close(g_fd);
        g_fd = -1;
        return -1;
    }
    printf("[SMS] Serial attr set\n");

    // 基础 AT 测试
    if (send_at_cmd("AT\r\n", "OK", 2000) != 0) {
        printf("[SMS] AT command failed\n");
        close(g_fd);
        g_fd = -1;
        return -1;
    }
    printf("[SMS] AT OK\n");

    // 设置为文本模式
    send_at_cmd("AT+CMGF=1\r\n", "OK", 2000);
    // 设置字符集为 GSM
    send_at_cmd("AT+CSCS=\"GSM\"\r\n", "OK", 2000);

    printf("[SMS] Init done\n");
    return 0;
}

/**
 * 发送短信
 * @param phone  目标手机号
 * @param msg    短信内容
 * @return 0=成功  1=失败
 */
int send_sms(const char *phone, const char *msg) {
    printf("[SMS] send_sms to %s: %s\n", phone, msg);

    if (g_fd < 0) {
        printf("[SMS] Not initialized\n");
        return 1;
    }

    // ===== 1. 清空串口接收缓冲区（避免读到上次残留数据） =====
    tcflush(g_fd, TCIFLUSH);

    // ===== 2. 发送 AT+CMGS 命令 =====
    char cmd[64];
    snprintf(cmd, sizeof(cmd), "AT+CMGS=\"%s\"\r\n", phone);
    printf("[SMS] Sending: %s", cmd);

    if (write(g_fd, cmd, strlen(cmd)) < 0) {
        perror("[SMS] write");
        return 1;
    }
    tcdrain(g_fd);

    // ===== 3. 等待 '>' 提示符（循环读取，最多等 8 秒） =====
    fd_set set;
    struct timeval tv;
    char buf[128];
    int got_prompt = 0;
    time_t start = time(NULL);

    printf("[SMS] Waiting for '>'...\n");

    while (time(NULL) - start < 8) {
        tv.tv_sec = 1;
        tv.tv_usec = 0;
        FD_ZERO(&set);
        FD_SET(g_fd, &set);

        int ret = select(g_fd + 1, &set, NULL, NULL, &tv);
        if (ret <= 0) continue;

        ssize_t n = read(g_fd, buf, sizeof(buf) - 1);
        if (n > 0) {
            buf[n] = '\0';
            printf("[SMS] RX: %s", buf);
            if (strchr(buf, '>') != NULL) {
                got_prompt = 1;
                break;
            }
        }
    }

    if (!got_prompt) {
        printf("[SMS] No '>' prompt received\n");
        // 发送 ESC 取消当前操作
        write(g_fd, "\x1B", 1);
        return 1;
    }

    // ===== 4. 发送消息内容 + Ctrl+Z =====
    printf("[SMS] Prompt received, sending message...\n");
    write(g_fd, msg, strlen(msg));
    usleep(100000);  // 等 100ms 让模块处理
    char ctrl_z = 0x1A;
    write(g_fd, &ctrl_z, 1);
    tcdrain(g_fd);

    // ===== 5. 等待 +CMGS: 和 OK 响应（最多等 30 秒） =====
    printf("[SMS] Waiting for result...\n");
    start = time(NULL);
    int got_cmgs = 0;
    int got_ok = 0;

    while (time(NULL) - start < 30) {
        tv.tv_sec = 2;
        tv.tv_usec = 0;
        FD_ZERO(&set);
        FD_SET(g_fd, &set);

        int ret = select(g_fd + 1, &set, NULL, NULL, &tv);
        if (ret <= 0) continue;

        ssize_t n = read(g_fd, buf, sizeof(buf) - 1);
        if (n > 0) {
            buf[n] = '\0';
            printf("[SMS] RX: %s", buf);
            if (strstr(buf, "+CMGS:") != NULL) got_cmgs = 1;
            if (strstr(buf, "OK") != NULL) got_ok = 1;
            if (got_cmgs && got_ok) {
                printf("[SMS] SMS sent successfully\n");
                return 0;
            }
        }
    }

    printf("[SMS] SMS failed (cmgs=%d, ok=%d)\n", got_cmgs, got_ok);
    return 1;
}