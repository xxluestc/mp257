#ifndef SMS_H
#define SMS_H

/**
 * 初始化短信模块（4G 模块 AT 指令）
 * @param device   串口设备路径，如 "/dev/ttySTM1"
 * @param baudrate 波特率，如 115200
 * @return 0=成功  -1=失败
 */
int sms_init(const char *device, int baudrate);

/**
 * 发送短信
 * @param phone  目标手机号
 * @param msg    短信内容（英文最多 160 字符，中文需 PDU 模式）
 * @return 0=成功  1=失败
 */
int send_sms(const char *phone, const char *msg);

#endif