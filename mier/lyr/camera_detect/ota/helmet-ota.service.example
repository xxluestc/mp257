[Unit]
Description=Helmet A35 OTA Service
Documentation=file:/opt/helmet-ota/README
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/helmet-ota
ExecStartPre=/opt/helmet-ota/helmet_ota_recover_if_needed.sh
ExecStart=/usr/bin/python3 -u /opt/helmet-ota/helmet_ota_server.py --host 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
UMask=0027

[Install]
WantedBy=multi-user.target
