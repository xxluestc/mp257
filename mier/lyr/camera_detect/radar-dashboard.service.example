[Unit]
Description=Rider Safety Dashboard and Control Plane
Documentation=file:/xxl/camera_detect/README.md
After=local-fs.target
Before=dvr.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/xxl/camera_detect
ExecStart=/usr/bin/python3 -u /xxl/camera_detect/dashboard/radar_dashboard.py --host 0.0.0.0 --port 8080 --data-dir /run/media/mmcblk0p1/dvr/radar_experiments --pid-file /tmp/radar_dashboard.pid
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=radar-dashboard

[Install]
WantedBy=multi-user.target
