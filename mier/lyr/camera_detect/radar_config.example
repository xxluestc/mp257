# 复制为 /xxl/camera_detect/radar_config 后由 start_dvr.sh 自动读取。
# 命令行 -T/-D/-p 优先于本文件。

# 原有雷达告警阈值
TTC=2.5
DIST=1.2

# 方向使用骑行者视角：rider_angle = 雷达协议原始 angle * ANGLE_SIGN。
# 当前雷达朝后安装，室外数据标定为正角在骑行者左后方，所以取 -1。
# radar_data.csv 仍保存协议原始角度，Dashboard 会按本参数转换后显示方位。
ANGLE_SIGN=-1

# 方向判断：rider_angle <= LEFT_ANGLE 为 LEFT，
# rider_angle >= RIGHT_ANGLE 为 RIGHT，中间为 CENTER。
LEFT_ANGLE=-10
RIGHT_ANGLE=10

# 角度 EMA 滤波权重，范围 (0, 1]；越小越平滑但响应越慢。
ANGLE_ALPHA=0.35

# 新方向连续出现多少帧后才确认切换。
DIRECTION_SAMPLES=3

# Dashboard 与实验日志
DASHBOARD_PORT=8080
RADAR_LOG_DIR=/usr/local/helmet/radar_experiments

# MP257 J15 USART2 -> CH9140。最终碰撞风险才会发送给 WBA：
# LEFT=左灯、RIGHT=右灯、CENTER=两灯、CLEAR=两灯熄灭。
BLE_LED_ENABLED=1
BLE_LED_UART=/dev/ttySTM0
